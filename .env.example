APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Email is captured locally by Laravel Herd's Mailpit (web inbox http://127.0.0.1:8025)
# For external delivery switch to smtp with a real provider (Postmark, SES, Resend...).

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# One-time password (email code) login
OTP_LOGIN_ENABLED=true
OTP_LOGIN_TTL=10
OTP_LOGIN_LENGTH=6
OTP_LOGIN_MAX_ATTEMPTS=5
OTP_LOGIN_RESEND_COOLDOWN=60

# Device binding & login alerts
SECURITY_BIND_DEVICE=true
SECURITY_NEW_DEVICE_ALERT=true

# Auth audit log & admin IP whitelist (comma separated, empty = open)
SECURITY_AUDIT_LOG=true
ADMIN_IP_WHITELIST=

# Passwordless magic link login (minutes a link stays valid)
MAGIC_LINK_ENABLED=true
MAGIC_LINK_TTL=15

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Social login (Laravel Socialite) — Google, GitHub, Facebook
SOCIAL_GOOGLE_ENABLED=false
SOCIAL_GITHUB_ENABLED=false
SOCIAL_FACEBOOK_ENABLED=false

# Google OAuth (console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=/auth/google/callback

# GitHub OAuth (github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=/auth/github/callback

# Facebook Login (developers.facebook.com/apps)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=/auth/facebook/callback

# Apple Sign In (developer.apple.com)
SOCIAL_APPLE_ENABLED=false
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_KEY_ID=
APPLE_TEAM_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=/auth/apple/callback

# Have I Been Pwned breach check
HIBP_API_URL=https://api.pwnedpasswords.com/range/
HIBP_CACHE_TTL=3600
HIBP_TIMEOUT=5
HIBP_FAIL_OPEN=true

VITE_APP_NAME="${APP_NAME}"
